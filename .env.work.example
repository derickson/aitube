# Environment for the passive "work" deployment (single-container image).
# Copy to .env.work for `make work-run`; in Kubernetes these come from a Secret/ConfigMap.
# This deployment needs ONLY the work cluster. Never put prod credentials here.

DEPLOYMENT=work

# The work Elasticsearch cluster (prod mirrors into it; this app only reads).
ELASTICSEARCH_URL=https://your-work-deployment.es.cloud.elastic.co
ELASTICSEARCH_API_KEY=your-work-api-key

# Optional per-feature overrides on top of DEPLOYMENT (ids in backend/app/features.py).
# FEATURES_ENABLE=topic_flow,embeddings
# FEATURES_DISABLE=search_explain

# Must match prod's content index choice. With the v2 index the work cluster also
# needs the semantic_text inference endpoint below.
CONTENT_ITEMS_INDEX=aitube-content-items
ENABLE_SEMANTIC_SEARCH=false
# SEMANTIC_INFERENCE_ID=.jina-embeddings-v5-omni-nano

# Optional backend APM
# ELASTIC_APM_SERVER_URL=
# ELASTIC_APM_API_KEY=
# ELASTIC_APM_ENVIRONMENT=work
