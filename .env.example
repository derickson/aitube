# Elasticsearch Serverless
ELASTICSEARCH_URL=https://your-deployment.es.cloud.elastic.co
ELASTICSEARCH_API_KEY=your-api-key-here

# Anthropic API (for AI summaries and ad detection)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Hermes summarization offload (optional). When enabled, transcript summaries run on
# GPT-5.4 mini via the Hermes agent over SSH, falling back to Claude Haiku on any failure.
# Disabled by default. Docker overrides HERMES_SSH_TARGET/OPTS (see docker-compose.yml).
HERMES_ENABLED=false
HERMES_SSH_TARGET=hermes          # ~/.ssh/config alias for `make dev`; root@IP in Docker
HERMES_SSH_OPTS=                  # extra ssh args, e.g. "-i /path/to/key -p 22"
HERMES_MODEL=gpt-5.4-mini         # "" to use the aitube profile's configured model
HERMES_PROFILE=aitube             # dedicated neutral profile (passed as `hermes -p aitube`)
HERMES_TIMEOUT_SECONDS=120

# Summarizer eval (Haiku vs Hermes). Shadow rate 0 = off; e.g. 0.05 = compare 5% of live summaries.
SUMMARY_EVAL_SHADOW_RATE=0.0

# Server
HOST=0.0.0.0
PORT=8000

# Polling age limits (days)
YOUTUBE_MAX_AGE_DAYS=5
PODCAST_MAX_AGE_DAYS=5
RSS_MAX_AGE_DAYS=120

# Elastic APM (Observability - separate from data Elasticsearch)
ELASTIC_APM_SERVER_URL=https://your-apm-endpoint.apm.cloud.elastic.co
ELASTIC_APM_SECRET_TOKEN=your-apm-secret-token
ELASTIC_APM_API_KEY=your-apm-api-key
ELASTIC_APM_ENVIRONMENT=development

# Frontend APM RUM (Vite build-time vars, no secret token needed)
# Opt-in: RUM stays off unless this is "true", even if a server URL is set.
# Disabled by default because browser intake currently fails in prod
# (HTTP status 0 / CORS). Backend Python APM (ELASTIC_APM_* above) is unaffected.
VITE_ELASTIC_APM_RUM_ENABLED=false
VITE_ELASTIC_APM_SERVER_URL=https://your-apm-endpoint.apm.cloud.elastic.co
VITE_ELASTIC_APM_ENVIRONMENT=development

# Semantic search (flip after EIS reindex cutover; defaults are v1 + lexical-only)
CONTENT_ITEMS_INDEX=aitube-content-items
ENABLE_SEMANTIC_SEARCH=false
SEMANTIC_INFERENCE_ID=.jina-embeddings-v5-omni-nano
